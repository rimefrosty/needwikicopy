      "text": "Blueprint Limits",
      "anchor": "diagram-rule"
    },
    {
      "type": "text",
      "text": "Each blueprint has its own maximum number of uses on the Excellion Suit and the Excellion Wing."
    },
    {
      "type": "table",
      "headers": [
        "Limit",
        "Description"
      ],
      "rows": [
        [
          "Equipment Limit",
          "Some blueprints are Suit-only or Wing-only."
        ],
        [
          "Duplicate Limit",
          "The same blueprint option can be added repeatedly only up to the count allowed for each equipment."
        ],
        [
          "First Slot Only",
          "Property blueprints can only be used on the first enchant slot."
        ],
        [
          "Slot Order",
          "The 1st enchant goes to slot 4, the 2nd to slot 3 and the 3rd to slot 2."
        ]
      ]
    },
