    {
      "type": "heading",
      "text": "Notes",
      "anchor": "notice"
    },
    {
      "type": "notice",
      "title": "No Reset",
      "text": "Excellion enchants cannot be reset by normal means. Choose your combination carefully before applying blueprints."
    },
    {
      "type": "notice",
      "title": "Equip the Item First",
      "text": "The Excellion Suit or Excellion Wing you want to enchant must be equipped."
    },
    {
      "type": "notice",
      "title": "Property Blueprints",
      "text": "The [ITEM:4970|Fire Property Reactor], [ITEM:4971|Water Property Reactor], [ITEM:4972|Earth Property Reactor] and [ITEM:4973|Wind Property Reactor] options can only be used on the first enchant slot. They cannot be used on equipment that already has another enchant."
    },
    {
      "type": "notice",
      "title": "Duplicate Limit",
      "text": "The same enchant can be added repeatedly only up to each blueprint's allowed count."
    },
