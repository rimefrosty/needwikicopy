      "type": "heading",
      "text": "Overview",
      "anchor": "overview"
    },
    {
      "type": "text",
      "text": "Fallen Angel Wings is a well-known garment that gets extra hidden enchants depending on its refine level."
    },
    {
      "type": "text",
      "text": "The higher the refine level, the more hidden enchants it can get."
    },
    {
      "type": "heading",
      "text": "Enchant Features",
      "anchor": "feature"
    },
    {
      "type": "notice",
      "title": "Enchants by Refine Level",
      "text": "Up to 3 hidden enchants can be added, depending on the refine level."
    },
    {
      "type": "table",
      "headers": [
        "Refine Level",
        "Hidden Enchants"
      ],
      "rows": [
        [
          "+0 ~ +6",
          "1"
        ],
        [
          "+7 ~ +8",
          "2"
        ],
        [
          "+9 or higher",
          "3"
        ]
      ]
    },
    {
      "type": "text",
      "text": "For each hidden enchant, you choose one of 13 options."
    },
    {
      "type": "text",
      "text": "The option's level and value are random."
    },
    {
      "type": "heading",
      "text": "Enchant Options",
      "anchor": "option"
    },
    {
      "type": "image",
      "path": "enchant/fallen_angel_wing_options.png",
      "caption": "Fallen Angel Wings enchant options"
    },
    {
      "type": "heading",
      "text": "Notes",
      "anchor": "notice"
    },
    {
      "type": "notice",
      "title": "No Reset",
      "text": "An applied enchant cannot be reset."
    },
    {
      "type": "notice",
      "title": "No Enchant Failure",
      "text": "Enchants never fail; the chosen option gets a random value."
    },
