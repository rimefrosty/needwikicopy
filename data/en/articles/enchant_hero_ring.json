    {
      "type": "text",
      "text": "Expert Enchanter Byrnes resets the enchants of the [ITEM:2981|Heroic Ring]."
    },
    {
      "type": "table",
      "headers": [
        "Entry",
        "Details"
      ],
      "rows": [
        [
          "Reset Material",
          "3 [ITEM:6684|Heroic Token]"
        ],
        [
          "Reset Target",
          "The equipped [ITEM:2981|Heroic Ring]"
        ],
        [
          "Reset Scope",
          "All enchant slots are reset"
        ],
        [
          "Caution",
          "You cannot reset only some slots"
        ]
      ]
    },
    {
      "type": "notice",
      "title": "Full Reset",
      "text": "A reset removes every enchant and returns the ring to a plain [ITEM:2981|Heroic Ring]."
    },
    {
      "type": "heading",
      "text": "Notes",
      "anchor": "notice"
    },
    {
      "type": "notice",
      "title": "Category Chosen, Value Random",
      "text": "You can choose the category, but the final option value is random among that category's 5 options."
    },
    {
      "type": "notice",
      "title": "Equal Chance",
      "text": "According to the script, one entry of the chosen category's option list is given, each with equal chance."
    },
    {
      "type": "notice",
      "title": "No Further Enchants",
      "text": "A [ITEM:2981|Heroic Ring] with every slot enchanted cannot be enchanted any further."
