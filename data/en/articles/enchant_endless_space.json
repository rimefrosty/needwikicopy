    {
      "type": "notice",
      "title": "Reset Can Destroy",
      "text": "Enchanting is safe, but a reset destroys the equipment with a 30% chance. Always check the equipment and materials before resetting."
    },
    {
      "type": "heading",
      "text": "Notes",
      "anchor": "notice"
    },
    {
      "type": "notice",
      "title": "Equip the Item First",
      "text": "Enchanting and resetting are done on equipment you are wearing. The target equipment must be equipped in the chosen slot."
    },
    {
      "type": "notice",
      "title": "Category Chosen, Option Random",
      "text": "You can choose the category (Physical, Magic or Ranged), but which option in it you get is random."
    },
    {
      "type": "notice",
      "title": "No More Than 2",
      "text": "Equipment that already has two enchants cannot be enchanted any further."
    },
