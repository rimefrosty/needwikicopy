          "Slots 3~4",
          "Spell, MATK%, SP"
        ],
        [
          "Slots 1~2",
          "STR, AGI, VIT, INT, DEX, LUK, MHP%, HP"
        ]
      ]
    },
    {
      "type": "text",
      "text": "Main options: Spell Lv 1~3, MATK +1~3%, SP +25~75"
    },
    {
      "type": "heading",
      "text": "Notes",
