      "headers": [
        "Order",
        "Battleground"
      ],
      "rows": [
        [
          "1",
          "Tierra Gorge"
        ],
        [
          "2",
          "Flavius"
        ],
        [
          "3",
          "KVM"
        ]
      ]
    },
