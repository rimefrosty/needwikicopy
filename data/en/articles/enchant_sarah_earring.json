          "Up to 2"
        ]
      ]
    },
    {
      "type": "notice",
      "title": "Must Be Equipped",
      "text": "The Sarah's Earring you want to enchant must be equipped in the left or right accessory slot."
    },
    {
      "type": "heading",
      "text": "Differences by Equip Slot",
      "anchor": "position"
    },
    {
      "type": "text",
      "text": "For Sarah's Earring enchants, the number of candidate options and the destruction rate depend on the equip slot."
    },
    {
      "type": "table",
      "headers": [
        "Equip Slot",
        "Candidate Options",
        "Rate per Option",
        "Success Rate",
        "Destroy Rate"
      ],
      "rows": [
        [
          "Left accessory slot",
          "4 common candidates",
          "20% each",
          "80%",
          "20%"
        ],
        [
          "Right accessory slot",
          "4 common candidates + 2 extra candidates",
          "10% each",
          "60%",
          "40%"
        ]
      ]
    },
    {
      "type": "notice",
      "title": "Extra Candidates in the Right Slot",
      "text": "Enchanting in the right accessory slot adds 2 extra candidates per category, but the overall destruction rate rises to 40%."
    },
    {
      "type": "heading",
      "text": "Enchant Categories",
      "anchor": "enchant-type"
    },
    {
      "type": "text",
      "text": "When enchanting, you choose one of the four categories below."
    },
    {
      "type": "table",
      "headers": [
        "Category",
        "Option Focus"
      ],
      "rows": [
        [
          "CRI or Critical",
          "CRI up, Critical damage up"
        ],
        [
          "Expert Archer or Evasion",
          "Ranged physical damage up, Perfect Dodge up"
        ],
        [
          "Saving or MATK",
          "Skill SP cost down, MATK up"
        ],
        [
          "After Attack Delay or After Skill Delay",
          "After Attack Delay down, After Skill Delay down"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "Option List",
      "anchor": "enchant-list"
    },
    {
      "type": "notice",
      "title": "About the List",
      "text": "The left accessory slot gives one of the 4 common candidates; the right accessory slot gives one of 6, including the 2 extra candidates."
    },
    {
      "type": "table",
      "headers": [
        "Category",
        "Common Candidates",
        "Extra Candidates (Right Slot)"
      ],
      "rows": [
        [
          "CRI or Critical",
          "Critical Lv 1~2, Fatal Lv 1~2",
          "Critical Lv 3, Fatal Lv 3"
        ],
        [
          "Expert Archer or Evasion",
          "Expert Archer Lv 1~2, Evasion Lv 1~2",
          "Evasion Lv 3, Expert Archer Lv 3"
        ],
        [
          "Saving or MATK",
          "Saving Lv 1~2, MATK 3~4%",
          "Saving Lv 3, MATK 5%"
        ],
        [
          "After Attack Delay or After Skill Delay",
          "After Attack Delay Lv 1~2, After Skill Delay Lv 1~2",
          "After Skill Delay Lv 3, After Attack Delay Lv 3"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "Reset",
      "anchor": "reset"
    },
    {
      "type": "text",
      "text": "The Assistant Professor resets the enchants on Sarah's Earrings."
    },
    {
      "type": "table",
      "headers": [
        "Entry",
        "Details"
      ],
      "rows": [
        [
          "Reset Material",
          "1 [ITEM:6803|Fragment of Gigantes]"
        ],
        [
          "Reset Target",
          "The equipped [ITEM:28310|Sarah's Left Earring] or [ITEM:28311|Sarah's Right Earring]"
        ],
        [
          "Reset Scope",
          "All enchants on it are reset"
        ],
        [
          "Reset Requirement",
          "Only earrings with at least 1 enchant"
        ]
      ]
    },
    {
      "type": "notice",
      "title": "Cannot Be Restored",
      "text": "Enchant stats removed by a reset cannot be restored."
    },
    {
      "type": "heading",
      "text": "Notes",
      "anchor": "notice"
    },
    {
      "type": "notice",
      "title": "Destruction Risk",
      "text": "A failed Sarah's Earring enchant destroys the equipment. Always check the destruction risk before enchanting."
    },
    {
      "type": "notice",
      "title": "Check the Equip Slot",
      "text": "The candidate options and the destruction rate depend on the equip slot. Do not mix up the left and right accessory slots."
    },
    {
      "type": "notice",
      "title": "Enchant Limit",
      "text": "An earring that already has 2 enchants cannot be enchanted any further."
    },
